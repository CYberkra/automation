#title: HS4T2D Debye-parameter scan v0.1 (eps_s=18.017 sigma=0.001 dEps=1 tau=1e-09; 8m altitude; companion of material-scan study)
#domain: 36 0.05 33
#dx_dy_dz: 0.025 0.05 0.025
#time_window: 600e-9
#omp_threads: 8
#pml_cells: 80 0 40 80 0 40
#pml_formulation: HORIPML
#waveform: impulse 1 1 impulse
#hertzian_dipole: y 14.6 0.025 20 impulse
#rx: 15.9 0.025 20 t01 Ey
#material: 9 0.001 1 0 rock
#material: 18.017 0.001 1 0 cover
#add_dispersion_debye: 1 1 1e-09 cover
#box: 0 0 0 36 0.05 12 rock
#box: 0 0 0 36 0.05 12 cover
#geometry_view: 0 0 0 36 0.05 33 0.025 0.05 0.025 hs4t2d_geom n
#src_steps: 0.5 0 0
#rx_steps: 0.5 0 0
