#title: HS4T2D aperture scan v0.1 (cover eps_r=12 sigma=0.001; 8m altitude; 30m aperture on 108m domain)
#domain: 108 0.05 33
#dx_dy_dz: 0.025 0.05 0.025
#time_window: 600e-9
#omp_threads: 8
#pml_cells: 80 0 40 80 0 40
#pml_formulation: HORIPML
#waveform: impulse 1 1 impulse
#hertzian_dipole: y 38.6 0.025 20 impulse
#rx: 39.9 0.025 20 t01 Ey
#material: 9 0.001 1 0 rock
#material: 12 0.001 1 0 cover
#box: 0 0 0 108 0.05 12 rock
#box: 0 0 0 108 0.05 12 cover
#geometry_view: 0 0 0 108 0.05 33 0.025 0.05 0.025 hs4t2d_geom n
#src_steps: 0.5 0 0
#rx_steps: 0.5 0 0
#dispersive_averaging: n
