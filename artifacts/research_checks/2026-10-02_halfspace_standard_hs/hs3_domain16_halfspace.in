#title: HS3 domain-sensitivity control v0.1 (domain y 12->16, Tx/Rx recentered, materials through PML); clean domain-width control vs HS1 (single change); frozen numerics identical to B3D5CM-t07
#domain_mode: 3D
#domain: 12 16 33
#dx_dy_dz: 0.05 0.05 0.05
#time_window: 600e-9
#omp_threads: 8
#pml_cells: 20 20 20 20 20 20
#pml_formulation: HORIPML
#waveform: impulse 1 1 impulse
#hertzian_dipole: x 6 7.35 27 impulse
#rx: 6 8.65 27 hs3 Ex
#pml_cfs: constant forward 0 0 constant forward 1 1 quartic forward 0 0.21235349838321013
#material: 9 0.001 1 0 rock
#material: 18.017 0.003 1 0 cover
#add_dispersion_debye: 1 7.878 6.4567e-09 cover
#box: 0 0 0 12 16 9  rock
#box: 0 0 9 12 16 12 cover
#geometry_view: 0 0 0 12 16 33 0.05 0.05 0.05 hs3_geom n
