#title: Normal-incidence Fresnel/slab diagnostic; no antenna port
#domain: 0.4 0.05 24
#dx_dy_dz: 0.05 0.05 0.05
#time_window: 300e-9
#omp_threads: 2
#pml_cells: 0 0 20 0 0 20
#pml_formulation: HORIPML
#symmetry_boundary: x0 pmc
#symmetry_boundary: xmax pmc
#waveform: ricker 1 100e6 pulse
#plane_wave_axial: 0 inf 3 0.4 inf 22 90 z pulse
#rx: 0.2 0 8 upper Ex Ey Ez
#rx: 0.1 0 8 transverse Ex Ey Ez
#rx: 0.2 0 16 lower Ex Ey Ez
#material: 9 0 1 0 cover
#material: 4 0 1 0 rock
#box: 0 0 12 0.4 0.05 24 cover n
#box: 0 0 15 0.4 0.05 24 rock n
